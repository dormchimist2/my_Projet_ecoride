{% extends 'base.html.twig' %}

{% block title %}Créer un employé{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Créer un compte employée</h1>

{# Affichage des messages flashs ici, dès le chargement de la page #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}
{% endfor %}

{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}


    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger">
            <ul>
                {% for error in form.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <!-- Informations personnelles -->
    <fieldset class="mb-4">
        <legend><h4>Informations personnelles</h4></legend>

        <div class="form-group mb-3">
            {{ form_label(form.firstName, 'Prénom') }}
            {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.firstName) }}
        </div>

        <div class="form-group mb-3">
            {{ form_label(form.lastName, 'Nom') }}
            {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.lastName) }}
        </div>

        <div class="form-group mb-3">
            {{ form_label(form.email, 'Email') }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-group mb-3">
            {{ form_label(form.phoneNumber, 'Téléphone') }}
            {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.phoneNumber) }}
        </div>

        <div class="form-group mb-3">
            {{ form_label(form.pseudo, 'Pseudo') }}
            {{ form_widget(form.pseudo, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.pseudo) }}
        </div>

        <div class="form-group mb-3">
            {{ form_label(form.password, 'Mot de passe') }}
            {{ form_widget(form.password, {'attr': {'class': 'form-control', 'autocomplete': 'new-password'}}) }}
            {{ form_errors(form.password) }}
        </div>

        <div class="form-group mb-3">
            {{ form_label(form.photo, 'Photo de profil') }}
            {{ form_widget(form.photo, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.photo) }}
        </div>
    </fieldset>

    <!-- Adresse -->
    <fieldset class="mb-4">
        <legend><h4>Adresse</h4></legend>
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_label(form.street, 'Rue') }}
                {{ form_widget(form.street, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.street) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_label(form.postalCode, 'Code postal') }}
                {{ form_widget(form.postalCode, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.postalCode) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_label(form.city, 'Ville') }}
                {{ form_widget(form.city, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.city) }}
            </div>
        </div>

        <div class="form-group mb-3">
            {{ form_label(form.country, 'Pays') }}
            {{ form_widget(form.country, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.country) }}
        </div>
    </fieldset>

    <!-- Rôles (seulement si visible pour l'admin) -->
    {% if form.roles is defined %}
        <div class="form-group mb-4">
            {{ form_label(form.roles, 'Rôles') }}
            <div class="d-flex flex-wrap gap-3">
                {% for choice in form.roles %}
                    <div class="form-check">
                        {{ form_widget(choice, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(choice, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                {% endfor %}
            </div>
            {{ form_errors(form.roles) }}
        </div>
    {% endif %}

    <!-- Bouton -->
    <div class="form-group mt-4 text-center">
        {{ form_widget(form.submit, {'attr': {'class': 'btn btn-success btn-lg'}, 'label': 'Créer l\'employé'}) }}
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
