{% extends 'base.html.twig' %}

{% block title %}Avis rejetés{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2 class="mb-4 text-danger">🛑 Avis rejetés</h2>

    {% if avis|length == 0 %}
        <div class="alert alert-info text-center">
            Aucun avis rejeté pour le moment.
        </div>
    {% else %}
        <ul class="list-group">
            {% for a in avis %}
                <li class="list-group-item shadow-sm mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong>{{ a.auteur.pseudo }}</strong>
                        <div class="d-flex">
                            {% for i in 1..5 %}
                                {% if i <= a.note %}
                                    <span class="text-warning">★</span> <!-- étoile pleine -->
                                {% else %}
                                    <span class="text-muted">☆</span> <!-- étoile vide -->
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    <p class="mt-2">{{ a.commentaire }}</p>
                    <span class="badge bg-danger">Rejeté</span>
                    <a href="{{ path('admin_avis_restaurer', {id: a.id}) }}" class="btn btn-warning btn-sm mt-2">Restaurer</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endblock %}
